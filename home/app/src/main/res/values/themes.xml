<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black from the first frame, no title, no window animation flash: the home screen draws everything. -->
    <style name="Theme.BaronHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">#FFEBEBEB</item>
        <!-- Every part draws its own focus (colour only): no grey box from Android on top of it. -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
</resources>
